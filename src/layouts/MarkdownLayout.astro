---
import Layout from "./Layout.astro";
import Tag from "@components/Tag.astro";

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} - Ali Aslanbayli`} description={frontmatter.excerpt}>
  <article class="container section-tight flex flex-col items-center text-center">
    <a
      href="/blog/"
      class="mb-10 inline-flex text-[15px] font-semibold text-[color:var(--text-secondary)] transition hover:text-[color:var(--text)]"
    >
      Back to blog
    </a>
    <header class="mb-12 max-w-[820px] text-center">
      <div class="mb-5 flex flex-wrap items-center justify-center gap-3 text-[15px] text-[color:var(--muted)]">
        <time datetime={frontmatter.date}>{new Date(frontmatter.date).toLocaleDateString("en", {
          month: "long",
          day: "numeric",
          year: "numeric",
        })}</time>
        <span aria-hidden="true">/</span>
        <span>{frontmatter.readTime}</span>
      </div>
      <h1 class="font-display mb-6 text-[clamp(40px,7vw,72px)] font-extrabold leading-[.98] tracking-[0]">
        {frontmatter.title}
      </h1>
      <p class="mx-auto max-w-[650px] text-xl leading-8 text-[color:var(--text-secondary)]">{frontmatter.excerpt}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {frontmatter.tags?.map((tag: string) => <Tag label={tag} />)}
      </div>
    </header>
    {frontmatter.cover && (
      <img
        src={frontmatter.cover}
        alt=""
        class="mx-auto mb-14 aspect-[16/9] w-full rounded-[24px] border border-[color:var(--border)] object-cover"
      />
    )}
    <div class="prose mx-auto">
      <slot />
    </div>
  </article>
</Layout>
