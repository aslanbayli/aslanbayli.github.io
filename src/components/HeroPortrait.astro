---
const badges = [
  { label: "Python", className: "left-0 top-8" },
  { label: "AI Agents", className: "-right-6 top-4" },
  { label: "LLMs", className: "-left-8 top-40" },
  { label: "Mojo", className: "right-0 top-48" },
  { label: "TypeScript", className: "left-8 bottom-8" },
  { label: "PyTorch", className: "right-10 bottom-3" },
  { label: "RAG", className: "-right-10 bottom-28" },
  { label: "Docker", className: "-left-5 bottom-24" },
];
---

<div class="relative mx-auto w-full max-w-[460px] lg:mr-0">
  <div
    class="absolute inset-10 rounded-full bg-[image:var(--hero-gradient)] opacity-30 blur-[70px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="surface relative mx-auto flex aspect-square w-[min(78vw,320px)] items-center justify-center overflow-hidden rounded-full border-2 border-white/10 p-3"
    style="animation: portrait-float 5s ease-in-out infinite;"
  >
    <img
      src="/me.png"
      alt="Portrait placeholder for Ali Aslanbayli"
      width="320"
      height="320"
      class="h-full w-full rounded-full object-cover"
    />
  </div>
  <div class="pointer-events-none hidden lg:block" aria-hidden="true">
    {
      badges.map((badge, index) => (
        <span
          class:list={[
            "absolute rounded-full border border-[color:var(--border)] bg-[rgba(18,24,36,.82)] px-3 py-2 text-sm font-semibold text-[color:var(--text-secondary)] shadow-[0_10px_30px_rgba(0,0,0,.28)] backdrop-blur",
            badge.className,
          ]}
          style={`animation: drift-soft ${7 + index}s ease-in-out infinite; animation-delay: ${index * 0.24}s;`}
        >
          {badge.label}
        </span>
      ))
    }
  </div>
</div>
