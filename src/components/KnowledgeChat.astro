---
const endpoint = import.meta.env.PUBLIC_CHAT_ENDPOINT ?? "";
---

<section class="section-tight pt-8 md:pt-12" aria-labelledby="chat-title">
  <div class="container">
    <div class="mx-auto max-w-[680px]">
      <p class="mb-3 text-center text-[11px] font-medium uppercase tracking-[.16em] text-[color:var(--muted)]">Ask the agent</p>
      <h2 id="chat-title" class="sr-only">Ask about Ali's work</h2>
      <div data-chat-messages hidden class="chat-conversation" aria-live="polite"></div>
      <form data-chat-form class="chatbox">
        <label class="sr-only" for="chat-message">Ask about Ali's work</label>
        <textarea id="chat-message" data-chat-input rows="1" maxlength="500" placeholder="What do you want to know?"></textarea>
        <div class="chat-toolbar">
          <p class="text-xs text-[color:var(--muted)]">Grounded in public work and writing</p>
          <button data-chat-send type="submit" class="chat-send" aria-label="Send question" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
          </button>
        </div>
      </form>
      <p data-chat-status class="mt-3 text-center text-sm text-[color:var(--muted)]">Answers include links to their public sources.</p>
    </div>
  </div>
</section>

<style>
  .chatbox { border: 1px solid var(--border); border-radius: 22px; padding: 16px 16px 12px; background: rgba(255,255,255,.035); box-shadow: inset 0 1px 0 rgba(255,255,255,.02), 0 20px 40px -20px rgba(0,0,0,.6); transition: border-color .2s ease, box-shadow .2s ease, background .2s ease; }
  .chat-conversation { max-height: 360px; margin-bottom: 16px; padding: 4px 2px 4px 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.2) transparent; }
  .chat-conversation > * + * { margin-top: 24px; }
  .chatbox:focus-within { border-color: rgba(255,107,61,.45); background: rgba(255,255,255,.055); box-shadow: 0 0 0 3px rgba(255,107,61,.12), 0 20px 40px -20px rgba(0,0,0,.6); }
  .chatbox textarea { display: block; width: 100%; max-height: 200px; resize: none; overflow-y: auto; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 15px; line-height: 1.5; padding: 4px 4px 8px; }
  .chatbox textarea::placeholder { color: var(--muted); }
  .chat-toolbar { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
  .chat-send { display: inline-flex; width: 34px; height: 34px; align-items: center; justify-content: center; border: 0; border-radius: 999px; background: var(--orange); color: #160b08; cursor: pointer; transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease; }
  .chat-send svg { width: 16px; height: 16px; }
  .chat-send:disabled { background: rgba(255,255,255,.08); color: rgba(255,255,255,.35); cursor: not-allowed; }
  .chat-send:not(:disabled):hover { transform: scale(1.05); box-shadow: 0 0 0 6px rgba(255,107,61,.12); }
</style>

<script define:vars={{ endpoint }}>
  const form = document.querySelector("[data-chat-form]");
  const input = document.querySelector("[data-chat-input]");
  const send = document.querySelector("[data-chat-send]");
  const messages = document.querySelector("[data-chat-messages]");
  const status = document.querySelector("[data-chat-status]");
  const key = "ali-knowledge-chat";
  const history = JSON.parse(sessionStorage.getItem(key) || "[]");
  const sessionKey = "ali-chat-session";
  if (!sessionStorage.getItem(sessionKey)) sessionStorage.setItem(sessionKey, crypto.randomUUID());
  const updateInput = () => { input.style.height = "auto"; input.style.height = `${Math.min(input.scrollHeight, 200)}px`; send.disabled = !input.value.trim(); };
  const addMessage = (role, text, sources = []) => { messages.hidden = false; const item = document.createElement("div"); item.className = role === "user" ? "ml-auto max-w-[85%] rounded-2xl bg-white/[.08] p-3" : "max-w-[85%] rounded-2xl border border-[color:var(--border)] p-3"; const escaped = text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;"); item.innerHTML = `<p class="text-sm leading-6">${escaped}</p>${sources.length ? `<div class="mt-3 flex flex-wrap gap-2">${sources.map((source) => `<a class="text-xs font-semibold text-[color:var(--orange)] underline" href="${source.url}">${source.title}</a>`).join("")}</div>` : ""}`; messages.append(item); messages.scrollTo({ top: messages.scrollHeight, behavior: "smooth" }); };
  history.forEach((item) => addMessage(item.role, item.text, item.sources));
  input.addEventListener("input", updateInput); input.addEventListener("keydown", (event) => { if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); form.requestSubmit(); } }); updateInput();
  form.addEventListener("submit", async (event) => { event.preventDefault(); const message = input.value.trim(); if (!message) return; const priorHistory = [...history]; addMessage("user", message); history.push({ role: "user", text: message }); input.value = ""; updateInput(); status.textContent = "Finding relevant public sources…"; if (!endpoint) { const answer = "This site build has no chat endpoint. Set PUBLIC_CHAT_ENDPOINT to the deployed Worker URL and rebuild the site."; addMessage("assistant", answer); history.push({ role: "assistant", text: answer, sources: [] }); status.textContent = "Chat endpoint missing from this deployment."; sessionStorage.setItem(key, JSON.stringify(history)); return; } try { const response = await fetch(endpoint, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ message, history: priorHistory, sessionId: sessionStorage.getItem(sessionKey) }) }); const data = await response.json(); if (!response.ok) throw new Error(data.error || "Chat is temporarily unavailable."); addMessage("assistant", data.answer, data.sources || []); history.push({ role: "assistant", text: data.answer, sources: data.sources || [] }); status.textContent = "Sources are linked below each answer."; } catch (error) { const answer = error instanceof Error ? error.message : "Chat is temporarily unavailable."; addMessage("assistant", answer); history.push({ role: "assistant", text: answer, sources: [] }); status.textContent = "Try again later or browse the public graph."; } sessionStorage.setItem(key, JSON.stringify(history)); });
</script>
