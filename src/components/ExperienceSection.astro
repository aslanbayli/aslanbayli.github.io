---
import SectionHeading from "./SectionHeading.astro";
import { experienceNote } from "../lib/knowledge";

interface Experience {
  title: string;
  company: string;
  location: string;
  period: string;
  highlights: string[];
}

const experiences: Experience[] = (experienceNote?.body ?? "")
  .split(/^## /m)
  .slice(1)
  .map((entry) => {
    const [title, metadata, ...lines] = entry.trim().split("\n");
    const [company, location, period] = metadata.split(" | ");

    return {
      title,
      company,
      location,
      period,
      highlights: lines
        .filter((line) => line.startsWith("- "))
        .map((line) => line.slice(2)),
    };
  });
---

<section id="experience" class="section">
  <div class="container">
    <SectionHeading
      label="Career"
      title="Experience"
      description="Building reliable AI systems, retrieval workflows, and tools that turn complex information into useful outcomes."
    />
    <div class="space-y-5">
      {
        experiences.map((experience) => (
          <article class="surface card-hover fade-up rounded-[24px] p-6 md:p-8">
            <div class="flex flex-col gap-5 border-b border-[color:var(--border)] pb-6 md:flex-row md:items-start md:justify-between">
              <div>
                <p class="text-sm font-bold uppercase tracking-[.14em] text-[color:var(--orange)]">{experience.company}</p>
                <h3 class="mt-2 font-display text-3xl font-extrabold tracking-[0] md:text-4xl">{experience.title}</h3>
              </div>
              <div class="shrink-0 text-left md:text-right">
                <p class="font-semibold text-[color:var(--text)]">{experience.period}</p>
                <p class="mt-1 text-base text-[color:var(--muted)]">{experience.location}</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 text-[color:var(--text-secondary)] marker:text-[color:var(--orange)]">
              {experience.highlights.map((highlight) => <li class="ml-5 pl-1 leading-7">{highlight}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
