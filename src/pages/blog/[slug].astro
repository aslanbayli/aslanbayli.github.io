---
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import { posts } from "../../lib/knowledge";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../content/vault/blog/public/*.md", { eager: true });
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post: modules[`../../../content/vault/blog/public/${post.slug}.md`] },
  }));
}

const { post } = Astro.props as { post: any };
const { Content } = post;
---

<MarkdownLayout frontmatter={post.frontmatter}>
  <Content />
</MarkdownLayout>
